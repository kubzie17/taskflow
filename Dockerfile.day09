FROM python:3.12-slim
WORKDIR /srv/taskflow
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY requirements.txt ./
COPY exercises/day05-requirements.txt exercises/day05-requirements.txt
RUN python -m pip install --no-cache-dir -r requirements.txt -r exercises/day05-requirements.txt \
    && groupadd --gid 10001 taskflow \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin taskflow
COPY app/ app/
COPY exercises/day04_candidate.py exercises/day05_api.py exercises/day05_identity.py exercises/day09_entry.py exercises/
ARG SOURCE_REVISION=local
LABEL org.opencontainers.image.title="TaskFlow protected training API" \
      org.opencontainers.image.revision=$SOURCE_REVISION
USER 10001:10001
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "exercises.day09_entry:application", "--factory", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
